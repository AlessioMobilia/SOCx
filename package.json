{
  "name": "so-cx",
  "displayName": "SOCx",
  "version": "1.4.1",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "targets": {
    "default": {
      "context": "browser",
      "includeNodeModules": true,
      "isLibrary": false
    }
  },
  "description": "Simple OSINT Centralized eXtension",
  "author": "Alessio Mobilia",
  "privacy_policy": "https://socx.alessiomobilia.com/privacy.html",
  "scripts": {
    "dev": "plasmo dev --target=chrome-mv3",
    "dev:chrome": "plasmo dev --target=chrome-mv3",
    "dev:edge": "plasmo dev --target=edge-mv3",
    "dev:firefox": "plasmo dev --target=firefox",
    "test": "vitest run --environment happy-dom",
    "typecheck": "tsc --noEmit --incremental false",
    "build": "plasmo build --target=chrome-mv3",
    "build:chrome": "plasmo build --target=chrome-mv3",
    "build:edge": "plasmo build --target=edge-mv3",
    "build:firefox": "plasmo build --target=firefox",
    "build:stores": "plasmo build --target=chrome-mv3 && plasmo build --target=edge-mv3 && plasmo build --target=firefox",
    "package": "plasmo build --target=chrome-mv3 --zip && plasmo build --target=edge-mv3 --zip && plasmo build --target=firefox --zip",
    "package:chrome": "plasmo build --target=chrome-mv3 --zip",
    "package:edge": "plasmo build --target=edge-mv3 --zip",
    "package:firefox": "plasmo build --target=firefox --zip",
    "package:stores": "plasmo build --target=chrome-mv3 --zip && plasmo build --target=edge-mv3 --zip && plasmo build --target=firefox --zip",
    "validate:builds": "node scripts/validate-builds.mjs",
    "verify": "pnpm test && tsc --noEmit --incremental false && plasmo build --target=chrome-mv3 && plasmo build --target=edge-mv3 && plasmo build --target=firefox && node scripts/validate-builds.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "tippy.js": "^6.3.7",
    "xlsx-js-style": "^1.2.0"
  },
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.html",
    "./**/**/*.ts",
    "./**/**/*.tsx",
    "./**/**/*.html"
  ],
  "compilerOptions": {
    "paths": {
      "~*": [
        "./src/*"
      ]
    },
    "baseUrl": "."
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "0.2.5",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.22",
    "happy-dom": "20.11.2",
    "plasmo": "0.90.5",
    "postcss": "^8.5.6",
    "prettier": "3.9.6",
    "svgo": "3.3.4",
    "tailwindcss": "^3.4.18",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*",
      "http://*/*",
      "file:///*"
    ],
    "permissions": [
      "contextMenus",
      "storage",
      "notifications",
      "clipboardWrite",
      "tabGroups"
    ],
    "commands": {
      "open-query-palette": {
        "suggested_key": {
          "default": "Ctrl+Shift+Comma"
        },
        "description": "Open the SOCx query palette"
      },
      "smart-format-selection": {
        "suggested_key": {
          "default": "Ctrl+Shift+Period"
        },
        "description": "Smart-format and copy the current selection"
      },
      "open-bulk-check": {
        "description": "Open the SOCx bulk IOC check"
      },
      "open-query-workspace": {
        "description": "Open the SOCx query workspace"
      },
      "open-query-builder": {
        "description": "Open the SOCx rule builder"
      },
      "open-subnet-extractor": {
        "description": "Open the SOCx subnet extractor"
      },
      "open-subnet-check": {
        "description": "Open the SOCx subnet abuse check"
      }
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "{017bef1c-5ecb-4a2e-a111-244174e2d9d8}",
        "data_collection_permissions": {
          "required": [
            "authenticationInfo",
            "websiteContent"
          ]
        }
      }
    },
    "web_accessible_resources": [
      {
        "matches": [
          "<all_urls>"
        ],
        "resources": [
          "assets/*"
        ]
      }
    ],
    "overrides": {
      "firefox": {
        "permissions": [
          "storage",
          "menus",
          "notifications",
          "clipboardWrite",
          "https://*/*",
          "http://*/*",
          "file:///*"
        ]
      }
    }
  }
}
