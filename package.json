{
  "name": "so-cx",
  "displayName": "SOCx",
  "version": "1.0.6",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "description": "Simple OSINT Centralized eXtension",
  "author": "Alessio Mobilia",
  "privacy_policy": "https://socx.alessiomobilia.com/privacy.html",
  "scripts": {
    "dev": "plasmo dev --target=chrome-mv3",
    "dev:chrome": "plasmo dev --target=chrome-mv3",
    "dev:edge": "plasmo dev --target=edge-mv3",
    "dev:firefox": "plasmo dev --target=firefox",
    "typecheck": "tsc --noEmit --incremental false",
    "build": "plasmo build --target=chrome-mv3",
    "build:chrome": "plasmo build --target=chrome-mv3",
    "build:edge": "plasmo build --target=edge-mv3",
    "build:firefox": "plasmo build --target=firefox",
    "build:stores": "plasmo build --target=chrome-mv3 && plasmo build --target=edge-mv3 && plasmo build --target=firefox",
    "package": "plasmo build --target=chrome-mv3 --zip && plasmo build --target=edge-mv3 --zip && plasmo build --target=firefox --zip",
    "package:chrome": "plasmo build --target=chrome-mv3 --zip",
    "package:edge": "plasmo build --target=edge-mv3 --zip",
    "package:firefox": "plasmo build --target=firefox --zip",
    "package:stores": "plasmo build --target=chrome-mv3 --zip && plasmo build --target=edge-mv3 --zip && plasmo build --target=firefox --zip",
    "validate:builds": "node scripts/validate-builds.mjs",
    "verify": "tsc --noEmit --incremental false && plasmo build --target=chrome-mv3 && plasmo build --target=edge-mv3 && plasmo build --target=firefox && node scripts/validate-builds.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "tippy.js": "^6.3.7",
    "xlsx-js-style": "^1.2.0"
  },
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.html",
    "./**/**/*.ts",
    "./**/**/*.tsx",
    "./**/**/*.html"
  ],
  "compilerOptions": {
    "paths": {
      "~*": [
        "./src/*"
      ]
    },
    "baseUrl": "."
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "0.2.5",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "plasmo": "0.90.5",
    "prettier": "3.9.6",
    "svgo": "3.3.4",
    "tailwindcss": "^3.4.18",
    "typescript": "5.9.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*",
      "file:///*"
    ],
    "permissions": [
      "contextMenus",
      "storage",
      "notifications",
      "clipboardWrite"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "{017bef1c-5ecb-4a2e-a111-244174e2d9d8}",
        "data_collection_permissions": {
          "required": [
            "authenticationInfo",
            "websiteContent"
          ]
        }
      }
    },
    "web_accessible_resources": [
      {
        "matches": [
          "<all_urls>"
        ],
        "resources": [
          "assets/*"
        ]
      }
    ]
  }
}
