{
  "schema": "socx.dialects/v1",
  "version": "2026-08-19",
  "description": "Query language definitions used by SOCx query packs. A dialect describes how a query language quotes, escapes and joins values. It never contains executable code: the escape strategy is a fixed identifier implemented inside the extension.",
  "dialects": [
    {
      "id": "kql",
      "label": "Kusto Query Language (Microsoft)",
      "vendors": [
        "Microsoft Defender XDR",
        "Microsoft Sentinel",
        "Azure Data Explorer"
      ],
      "statementStyle": "piped",
      "escape": "backslash",
      "quote": "\"",
      "listStrategy": "in-operator",
      "listOpen": "(",
      "listClose": ")",
      "separator": ", ",
      "operators": {
        "equals": "==",
        "in": "in~",
        "contains": "has_any",
        "regex": "matches regex",
        "and": "and",
        "or": "or",
        "not": "not"
      },
      "comment": "// ",
      "timeInQuery": true,
      "timeExpression": "ago({{value}})",
      "caseInsensitive": "~",
      "maxItems": 100,
      "maxLength": 8000,
      "notes": "in~ and has_any are case insensitive, which is what you want for hostnames and file names. Use in (case sensitive) for hashes only when the source normalises them."
    },
    {
      "id": "spl",
      "label": "Search Processing Language (Splunk)",
      "vendors": [
        "Splunk Enterprise",
        "Splunk Cloud",
        "CrowdStrike Falcon Event Search"
      ],
      "statementStyle": "piped",
      "escape": "backslash",
      "quote": "\"",
      "listStrategy": "in-operator",
      "listOpen": "(",
      "listClose": ")",
      "separator": ", ",
      "operators": {
        "equals": "=",
        "in": "IN",
        "contains": "IN",
        "regex": "regex",
        "and": "AND",
        "or": "OR",
        "not": "NOT"
      },
      "comment": "``` ",
      "commentClose": " ```",
      "timeInQuery": true,
      "timeExpression": "earliest=-{{value}}",
      "maxItems": 200,
      "maxLength": 10000,
      "notes": "Splunk comments are wrapped in triple backticks. The IN operator is available in the search command since 6.6 and in where since 8.0."
    },
    {
      "id": "udm",
      "label": "UDM Search (Google SecOps / Chronicle)",
      "vendors": ["Google Security Operations", "Chronicle SIEM"],
      "statementStyle": "boolean",
      "escape": "backslash",
      "quote": "\"",
      "listStrategy": "or-expansion",
      "listOpen": "(",
      "listClose": ")",
      "separator": " OR ",
      "operators": {
        "equals": "=",
        "in": "=",
        "contains": "=",
        "regex": "re.regex",
        "and": "AND",
        "or": "OR",
        "not": "NOT"
      },
      "comment": null,
      "timeInQuery": false,
      "caseInsensitive": "nocase",
      "maxItems": 150,
      "maxLength": 6000,
      "notes": "UDM Search has no IN operator, so lists are expanded into OR chains. The time range comes from the console time picker, never from the query text."
    },
    {
      "id": "yaral",
      "label": "YARA-L 2.0 (Google SecOps detection rules)",
      "vendors": ["Google Security Operations"],
      "statementStyle": "boolean",
      "escape": "backslash",
      "quote": "\"",
      "listStrategy": "or-expansion",
      "listOpen": "(",
      "listClose": ")",
      "separator": " or ",
      "operators": {
        "equals": "=",
        "in": "in",
        "contains": "=",
        "regex": "re.regex",
        "and": "and",
        "or": "or",
        "not": "not"
      },
      "comment": "// ",
      "timeInQuery": false,
      "maxItems": 100,
      "maxLength": 12000,
      "notes": "Detection rule format rather than a search language. Used by SOCx as an export target."
    },
    {
      "id": "logscale",
      "label": "LogScale Query Language (CrowdStrike)",
      "vendors": [
        "CrowdStrike Falcon LogScale",
        "CrowdStrike Falcon Next-Gen SIEM",
        "Humio"
      ],
      "statementStyle": "piped",
      "escape": "backslash",
      "quote": "\"",
      "listStrategy": "in-operator",
      "listOpen": "values=[",
      "listClose": "]",
      "separator": ", ",
      "operators": {
        "equals": "=",
        "in": "in",
        "contains": "like",
        "regex": "=~",
        "and": "and",
        "or": "or",
        "not": "not"
      },
      "comment": "// ",
      "timeInQuery": false,
      "maxItems": 200,
      "maxLength": 8000,
      "notes": "in() is a function: in(field=Name, values=[\"a\", \"b\"]). The search window is set by the console time picker."
    },
    {
      "id": "xql",
      "label": "XQL (Palo Alto Cortex XDR / XSIAM)",
      "vendors": ["Cortex XDR", "Cortex XSIAM"],
      "statementStyle": "piped",
      "escape": "backslash",
      "quote": "\"",
      "listStrategy": "in-operator",
      "listOpen": "(",
      "listClose": ")",
      "separator": ", ",
      "operators": {
        "equals": "=",
        "in": "in",
        "contains": "contains",
        "regex": "~=",
        "and": "and",
        "or": "or",
        "not": "not"
      },
      "comment": "// ",
      "timeInQuery": false,
      "maxItems": 100,
      "maxLength": 8000,
      "notes": "Queries always start from a dataset. The time range is chosen in the query editor, not in the text."
    },
    {
      "id": "aql",
      "label": "Ariel Query Language (IBM QRadar)",
      "vendors": ["IBM QRadar SIEM"],
      "statementStyle": "sql",
      "escape": "sql-quote",
      "quote": "'",
      "listStrategy": "in-operator",
      "listOpen": "(",
      "listClose": ")",
      "separator": ", ",
      "operators": {
        "equals": "=",
        "in": "IN",
        "contains": "ILIKE",
        "regex": "MATCHES",
        "and": "AND",
        "or": "OR",
        "not": "NOT"
      },
      "comment": null,
      "timeInQuery": true,
      "timeExpression": "LAST {{value}}",
      "maxItems": 200,
      "maxLength": 12000,
      "notes": "Single quoted strings, doubled to escape. The time filter is a trailing LAST clause, expressed as '7 DAYS' rather than '7d'."
    },
    {
      "id": "lucene",
      "label": "Lucene query syntax",
      "vendors": [
        "Elasticsearch",
        "Kibana",
        "OpenSearch",
        "Graylog",
        "VMware Carbon Black"
      ],
      "statementStyle": "boolean",
      "escape": "lucene",
      "quote": "\"",
      "listStrategy": "or-expansion",
      "listOpen": "(",
      "listClose": ")",
      "separator": " OR ",
      "operators": {
        "equals": ":",
        "in": ":",
        "contains": ":",
        "regex": ":/",
        "and": "AND",
        "or": "OR",
        "not": "NOT"
      },
      "comment": null,
      "timeInQuery": false,
      "maxItems": 300,
      "maxLength": 6000,
      "notes": "Reserved characters + - && || ! ( ) { } [ ] ^ \" ~ * ? : \\ / must be backslash escaped inside values."
    },
    {
      "id": "es-kql",
      "label": "Kibana Query Language (Elastic)",
      "vendors": ["Elasticsearch", "Kibana", "Elastic Security"],
      "statementStyle": "boolean",
      "escape": "lucene",
      "quote": "\"",
      "listStrategy": "or-expansion",
      "listOpen": "(",
      "listClose": ")",
      "separator": " or ",
      "operators": {
        "equals": ":",
        "in": ":",
        "contains": ":*",
        "regex": ":",
        "and": "and",
        "or": "or",
        "not": "not"
      },
      "comment": null,
      "timeInQuery": false,
      "maxItems": 300,
      "maxLength": 6000,
      "notes": "Elastic's KQL is NOT the Microsoft KQL of the 'kql' dialect. Same three letters, unrelated languages."
    },
    {
      "id": "esql",
      "label": "ES|QL (Elastic)",
      "vendors": ["Elasticsearch 8.11+", "Elastic Security"],
      "statementStyle": "piped",
      "escape": "backslash",
      "quote": "\"",
      "listStrategy": "in-operator",
      "listOpen": "(",
      "listClose": ")",
      "separator": ", ",
      "operators": {
        "equals": "==",
        "in": "IN",
        "contains": "LIKE",
        "regex": "RLIKE",
        "and": "AND",
        "or": "OR",
        "not": "NOT"
      },
      "comment": "// ",
      "timeInQuery": true,
      "timeExpression": "NOW() - {{value}}",
      "maxItems": 200,
      "maxLength": 8000
    },
    {
      "id": "fortisiem",
      "label": "FortiSIEM analytics filter",
      "vendors": ["FortiSIEM"],
      "statementStyle": "boolean",
      "escape": "backslash",
      "quote": "\"",
      "listStrategy": "in-operator",
      "listOpen": "(",
      "listClose": ")",
      "separator": ", ",
      "operators": {
        "equals": "=",
        "in": "IN",
        "contains": "CONTAIN",
        "regex": "REGEXP",
        "and": "AND",
        "or": "OR",
        "not": "NOT"
